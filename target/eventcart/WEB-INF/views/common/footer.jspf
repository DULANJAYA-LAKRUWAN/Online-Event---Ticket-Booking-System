<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>

<footer class="footer-eventcart mt-auto">
    <div class="container">
        <div class="row g-4">
            <!-- Brand & Tagline -->
            <div class="col-lg-4 col-md-6">
                <div class="d-flex align-items-center mb-3">
                    <span class="navbar-brand-icon">
                        <i class="bi bi-ticket-perforated-fill"></i>
                    </span>
                    <span class="navbar-brand-title">Event<span class="text-primary">Cart</span></span>
                </div>
                <p class="small text-secondary mb-3">
                    Discover unforgettable concerts, sports tournaments, tech conferences, and theater performances. Secure, seamless booking designed for modern event enthusiasts.
                </p>
                <div class="d-flex gap-2">
                    <a href="#" class="btn btn-sm btn-outline-secondary text-light"><i class="bi bi-facebook"></i></a>
                    <a href="#" class="btn btn-sm btn-outline-secondary text-light"><i class="bi bi-twitter-x"></i></a>
                    <a href="#" class="btn btn-sm btn-outline-secondary text-light"><i class="bi bi-instagram"></i></a>
                    <a href="#" class="btn btn-sm btn-outline-secondary text-light"><i class="bi bi-linkedin"></i></a>
                </div>
            </div>

            <!-- Quick Links -->
            <div class="col-lg-2 col-md-6">
                <h6 class="footer-title">Navigation</h6>
                <ul class="list-unstyled">
                    <li><a href="${pageContext.request.contextPath}/" class="footer-link">Home</a></li>
                    <li><a href="${pageContext.request.contextPath}/#featured-events" class="footer-link">Browse Events</a></li>
                    <li><a href="${pageContext.request.contextPath}/login" class="footer-link">My Account</a></li>
                    <li><a href="${pageContext.request.contextPath}/register" class="footer-link">Create Account</a></li>
                </ul>
            </div>

            <!-- Event Categories -->
            <div class="col-lg-3 col-md-6">
                <h6 class="footer-title">Categories</h6>
                <ul class="list-unstyled">
                    <li><a href="#" class="footer-link">Music &amp; Concerts</a></li>
                    <li><a href="#" class="footer-link">Tech &amp; Innovation</a></li>
                    <li><a href="#" class="footer-link">Sports &amp; Fitness</a></li>
                    <li><a href="#" class="footer-link">Arts &amp; Theater</a></li>
                </ul>
            </div>

            <!-- Academic Info & System Status -->
            <div class="col-lg-3 col-md-6">
                <h6 class="footer-title">Project Specification</h6>
                <p class="small text-secondary mb-1">
                    <strong>Web Programming II</strong> Assessment
                </p>
                <p class="small text-secondary mb-2">
                    Architecture: MVC (JSP + Servlets + Hibernate 6 + MySQL 8)
                </p>
                <span class="badge bg-success-subtle text-success border border-success-subtle">
                    <i class="bi bi-check2-circle me-1"></i> Phase 01 Foundation Active
                </span>
            </div>
        </div>

        <!-- Copyright -->
        <div class="footer-bottom text-center text-secondary">
            <p class="mb-0">&copy; <%= java.time.Year.now().getValue() %> EventCart Platform. All rights reserved. Academic Assessment Project.</p>
        </div>
    </div>
</footer>

<!-- Bootstrap 5.3 Bundle JS CDN -->
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js" integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz" crossorigin="anonymous"></script>

<!-- EventCart Main JS -->
<script src="${pageContext.request.contextPath}/assets/js/main.js"></script>
</body>
</html>
