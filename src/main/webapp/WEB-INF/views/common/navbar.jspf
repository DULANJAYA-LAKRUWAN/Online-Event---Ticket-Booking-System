<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>

<nav class="navbar navbar-expand-lg navbar-dark navbar-eventcart sticky-top py-2">
    <div class="container">
        <!-- Brand Logo -->
        <a class="navbar-brand d-flex align-items-center" href="${pageContext.request.contextPath}/">
            <span class="navbar-brand-icon">
                <i class="bi bi-ticket-perforated-fill"></i>
            </span>
            <span class="navbar-brand-title">Event<span class="text-primary">Cart</span></span>
        </a>

        <!-- Mobile Toggler -->
        <button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse" data-bs-target="#navbarContent"
                aria-controls="navbarContent" aria-expanded="false" aria-label="Toggle navigation">
            <span class="navbar-toggler-icon"></span>
        </button>

        <!-- Navbar Links -->
        <div class="collapse navbar-collapse" id="navbarContent">
            <ul class="navbar-nav me-auto mb-2 mb-lg-0 ms-lg-3">
                <li class="nav-item">
                    <a class="nav-link ${pageActive == 'home' ? 'active' : ''}" href="${pageContext.request.contextPath}/">
                        <i class="bi bi-house-door me-1"></i> Home
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link ${pageActive == 'events' ? 'active' : ''}" href="${pageContext.request.contextPath}/events">
                        <i class="bi bi-compass me-1"></i> Explore Events
                    </a>
                </li>
            </ul>

            <!-- Search input bar in navbar -->
            <form class="d-none d-lg-flex me-3 position-relative" action="${pageContext.request.contextPath}/events" method="get">
                <input class="form-control form-control-sm bg-dark text-light border-secondary ps-4" type="search" name="query"
                       placeholder="Search concerts, sports..." aria-label="Search" style="width: 220px;">
                <i class="bi bi-search position-absolute top-50 start-0 translate-middle-y text-secondary ms-2 small"></i>
            </form>

            <!-- User Session / Action Buttons -->
            <ul class="navbar-nav align-items-lg-center">
                <!-- Cart Icon with badge -->
                <li class="nav-item me-lg-3 position-relative">
                    <a class="nav-link ${pageActive == 'cart' ? 'active' : ''}" href="${pageContext.request.contextPath}/cart" title="Shopping Cart" id="nav-cart-btn">
                        <i class="bi bi-cart3 fs-5"></i>
                        <span class="cart-badge" id="cart-badge-count"><c:out value="${sessionScope.EVENTCART_SESSION_CART != null ? sessionScope.EVENTCART_SESSION_CART.totalQuantity : 0}" /></span>
                    </a>
                </li>

                <c:choose>
                    <c:when test="${not empty sessionScope.authUser}">
                        <!-- Logged-in User Dropdown -->
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle d-flex align-items-center" href="#" role="button"
                               data-bs-toggle="dropdown" aria-expanded="false">
                                <i class="bi bi-person-circle fs-5 me-2 text-primary"></i>
                                <span><c:out value="${sessionScope.userName != null ? sessionScope.userName : 'My Account'}" /></span>
                            </a>
                            <ul class="dropdown-menu dropdown-menu-end shadow-sm border-0">
                                <li>
                                    <h6 class="dropdown-header">
                                        Signed in as <span class="badge bg-primary text-uppercase">${sessionScope.userRole}</span>
                                    </h6>
                                </li>
                                <li><hr class="dropdown-divider"></li>
                                <c:if test="${sessionScope.userRole == 'ADMIN'}">
                                    <li><h6 class="dropdown-header text-primary fw-bold">Admin Management</h6></li>
                                    <li><a class="dropdown-item" href="${pageContext.request.contextPath}/admin/events"><i class="bi bi-calendar-event me-2 text-primary"></i>Manage Events</a></li>
                                    <li><a class="dropdown-item" href="${pageContext.request.contextPath}/admin/categories"><i class="bi bi-tags me-2 text-primary"></i>Manage Categories</a></li>
                                    <li><hr class="dropdown-divider"></li>
                                </c:if>
                                <c:if test="${sessionScope.userRole == 'ORGANIZER'}">
                                    <li><a class="dropdown-item text-success" href="${pageContext.request.contextPath}/admin/events"><i class="bi bi-calendar-plus me-2"></i>My Events</a></li>
                                    <li><hr class="dropdown-divider"></li>
                                </c:if>
                                <li><a class="dropdown-item" href="${pageContext.request.contextPath}/profile"><i class="bi bi-person me-2"></i>My Profile</a></li>
                                <li><a class="dropdown-item" href="${pageContext.request.contextPath}/my-tickets"><i class="bi bi-ticket-detailed me-2"></i>My Bookings</a></li>
                                <li><hr class="dropdown-divider"></li>
                                <li><a class="dropdown-item text-danger" href="${pageContext.request.contextPath}/logout"><i class="bi bi-box-arrow-right me-2"></i>Log Out</a></li>
                            </ul>
                        </li>
                    </c:when>
                    <c:otherwise>
                        <!-- Guest Navigation -->
                        <li class="nav-item me-2">
                            <a class="btn btn-outline-event btn-sm" href="${pageContext.request.contextPath}/login">
                                <i class="bi bi-box-arrow-in-right me-1"></i> Sign In
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="btn btn-primary-event btn-sm" href="${pageContext.request.contextPath}/register">
                                <i class="bi bi-person-plus me-1"></i> Register
                            </a>
                        </li>
                    </c:otherwise>
                </c:choose>
            </ul>
        </div>
    </div>
</nav>
